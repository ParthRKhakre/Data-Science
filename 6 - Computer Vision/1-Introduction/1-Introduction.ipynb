    "sobel_horizontal_image.shape\n",
    "\n",
    "plt.figure(figsize=(10,5))\n",
    "\n",
    "plt.subplot(1,2,1)\n",
    "plt.title(\"Sobel Output\")\n",
    "plt.imshow(sobel_horizontal_image,cmap='gray')\n",
    "plt.axis('off')"
   ]
